<service>
  <id>vaultdeck-api</id>
  <name>VaultDeck API</name>
  <description>VaultDeck backend service</description>
  <executable>%VAULTDECK_HOME%\runtime\node\node.exe</executable>
  <arguments>"%VAULTDECK_HOME%\current\api\main.js"</arguments>
  <workingdirectory>%VAULTDECK_HOME%\current</workingdirectory>
  <env name="VD_STORE" value="postgres" />
  <env name="PORT" value="3000" />
  <env name="VD_DATABASE_URL" value="%VAULTDECK_DB_URL%" />
  <env name="VD_MIGRATIONS_DIR" value="%VAULTDECK_HOME%\current\migrations" />
  <env name="VD_DATA_ROOT" value="%VAULTDECK_HOME%\data\storage" />
  <env name="VD_PREVIEW_CACHE" value="%VAULTDECK_HOME%\data\previews" />
  <env name="VD_AVATAR_ROOT" value="%VAULTDECK_HOME%\data\storage\avatars" />
  <env name="VD_ENCRYPTION_KEY_FILE" value="%VAULTDECK_HOME%\secrets\encryption.key" />
  <env name="VD_SOFFICE_PATH" value="%VAULTDECK_HOME%\tools\libreoffice\program\soffice.exe" />
  <logpath>%VAULTDECK_HOME%\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
