worker_processes 1;
# 路径基准实测（Windows nginx 1.30.6）：
#   ssl_certificate / ssl_certificate_key → 相对「配置文件所在目录 conf/」
#   root                                 → 相对「exe 所在目录（tools/nginx/）」
# 发布包结构：tools/nginx/{conf/nginx.conf, certs/, app/}
#   证书在 conf 的上一级 → ../certs/；前端在 exe 同级 → app/
error_log logs/error.log warn;
pid logs/nginx.pid;

events {
  worker_connections 1024;
}

http {
  include mime.types;
  default_type application/octet-stream;
  access_log off;
  sendfile off;
  keepalive_timeout 65;
  client_max_body_size 16m;

  limit_req_zone $binary_remote_addr zone=vd_api:10m rate=50r/s;

  server {
    listen 80;
    server_name _;
    return 301 https://$host:8443$request_uri;
  }

  server {
    listen 8443 ssl;
    http2 on;
    server_name localhost;

    ssl_certificate ../certs/server.crt;
    ssl_certificate_key ../certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    # 双向 TLS（可选）：由 deploy/windows/gen-certs.ps1 -ClientName <name> 生成
    # certs/client-ca.crt 后取消下面三行注释，并设置机器环境变量 VD_REQUIRE_CLIENT_CERT=true
    # ssl_client_certificate ../certs/client-ca.crt;
    # ssl_verify_client optional;
    # ssl_verify_depth 2;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    root app;
    index index.html;

    location / {
      try_files $uri $uri/ /index.html;
    }

    location /api/ {
      limit_req zone=vd_api burst=40 nodelay;
      proxy_pass http://127.0.0.1:3000;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      # 双向 TLS（可选）：与 server 段的 ssl_client_certificate 一起启用
      # proxy_set_header X-Client-Verify $ssl_client_verify;
      # proxy_set_header X-Client-DN $ssl_client_s_dn;
      # proxy_set_header X-Client-Fingerprint $ssl_client_fingerprint;
      proxy_request_buffering off;
      proxy_buffering off;
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
    }
  }
}
